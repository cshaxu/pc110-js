{
  "name": "pc110-js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.0.0",
    "npm": "10.9.4"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check \"src/**/*.ts\" \"*.{json,mjs,yaml}\"",
    "dev": "vite",
    "serve": "node scripts/serve.mjs",
    "headless": "npm run build && node build/headless/main.js",
    "trace:rebuilt-rom": "npm run build && node build/reference/rebuilt-rom-trace.js",
    "reference": "npm run build && node build/reference/reference-server.js --open",
    "reference:serve": "npm run build && node build/reference/reference-server.js"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vite": "6.0.5",
    "vitest": "2.1.8"
  }
}
